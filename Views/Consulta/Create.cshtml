@* Define o tipo de modelo fortemente tipado esperado por esta View *@
@model appReversotask.Models.Consulta

@{
    // Define o título da página no layout compartilhado (_Layout.cshtml)
    ViewData["Title"] = "Criar Consulta";
}

<h1>Create</h1>
<h4>Consulta</h4>
<hr />

<div class="row">
    <div class="col-md-4">

        @* Formulário configurado via Tag Helper para enviar os dados via POST para a Action 'Create' do ConsultaController *@
        <form asp-action="Create">

            @* Exibe mensagens de erro globais referentes ao Model *@
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Campo para entrada da Data e Hora da consulta *@
            <div class="form-group mb-3">
                @* Rótulo gerado automaticamente com base na propriedade DataHora *@
                <label asp-for="DataHora" class="control-label"></label>

                @* Input vinculado à propriedade DataHora *@
                <input asp-for="DataHora" class="form-control" />

                @* Exibe a mensagem de validação específica do campo DataHora *@
                <span asp-validation-for="DataHora" class="text-danger"></span>
            </div>

            @* Campo de seleção para o Status da consulta *@
            <div class="form-group mb-3">
                <label asp-for="StatusConsulta" class="control-label"></label>

                @*
                Dropdown com os possíveis estados da consulta.
                O valor selecionado será enviado para a propriedade StatusConsulta.
                *@
                <select asp-for="StatusConsulta" class="form-control">
                    <option value="">-- Selecione o Status --</option>
                    <option value="Agendada">Agendada</option>
                    <option value="Realizada">Realizada</option>
                    <option value="Cancelada">Cancelada</option>
                </select>

                @* Exibe a mensagem de validação específica do campo StatusConsulta *@
                <span asp-validation-for="StatusConsulta" class="text-danger"></span>
            </div>

            @* Campo de seleção para o Médico responsável pela consulta *@
            <div class="form-group mb-3">

                @* Define o texto exibido no rótulo como 'Médico' *@
                <label asp-for="MedicoId" class="control-label">Médico</label>

                @*
                Popula o dropdown utilizando a SelectList
                enviada pela ConsultaController através da ViewBag.
                *@
                <select asp-for="MedicoId"
                        class="form-control"
                        asp-items="ViewBag.MedicoId">

                    <option value="">-- Selecione o Médico --</option>

                </select>

                @* Exibe a mensagem de validação específica do campo MedicoId *@
                <span asp-validation-for="MedicoId" class="text-danger"></span>
            </div>

            @*
            O PacienteId NÃO aparece no formulário.

            O paciente é definido automaticamente pela ConsultaController
            através da sessão do usuário autenticado.
            *@

            @* Botões de ação do formulário *@
            <div class="form-group mt-3">

                @* Botão responsável por enviar o formulário para a Action Create *@
                <input type="submit"
                       value="Cadastrar"
                       class="btn btn-primary" />

                @* Link para retornar à listagem de consultas *@
                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </div>

        </form>
    </div>
</div>

@section Scripts {
    @* Carrega os scripts de validação do ASP.NET Core *@
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
